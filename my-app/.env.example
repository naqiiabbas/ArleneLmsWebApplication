# Supabase — copy to .env.local and fill in the values.
# Dashboard → Project Settings → API

# Public (browser-safe). RLS enforces access for these keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SERVER ONLY — bypasses RLS. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Base URL of this app (password-reset email redirect links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

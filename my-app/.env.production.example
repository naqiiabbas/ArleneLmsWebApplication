# ── Production env for Docker / VPS ─────────────────────────────
# On the VPS: copy this file to ".env" (docker compose auto-loads it),
# then fill in the real values. Do NOT commit the filled-in .env.
#
#   cp .env.production.example .env
#
# NEXT_PUBLIC_* are read as BUILD ARGS (baked into the browser bundle),
# so you must rebuild the image whenever you change them.
# SUPABASE_SERVICE_ROLE_KEY is a RUNTIME-only secret (never in the bundle).

# Supabase project API (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SERVER ONLY — bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Host port to publish on the VPS (container always listens on 3000).
# Pick one NOT used by other projects on the box, e.g. 3010.
WEB_PORT=3010

# Public URL clients will hit (used for password-reset redirect links).
# No domain? Use the VPS IP + the WEB_PORT above.
# e.g. http://203.0.113.10:3010   (or https://app.yourclientdomain.com if you add a domain later)
NEXT_PUBLIC_SITE_URL=http://YOUR_VPS_IP:3010

# ── Production env for Docker / AWS EC2 ─────────────────────────
# On the server: copy this file to ".env" (docker compose auto-loads it),
# then fill in the real values. Do NOT commit the filled-in .env.
#
#   cp .env.production.example .env
#
# NEXT_PUBLIC_* are read as BUILD ARGS (baked into the browser bundle),
# so you must rebuild the image whenever you change them.
# SUPABASE_SERVICE_ROLE_KEY is a RUNTIME-only secret (never in the bundle).

# Self-hosted Supabase on this server (see DEPLOY.md → Self-hosted Supabase).
# Caddy serves its API on the LMS hostname, so the URL is the site's own URL.
# Keys: ANON_KEY / SERVICE_ROLE_KEY from ~/supabase/docker/.env
NEXT_PUBLIC_SUPABASE_URL=https://admin.100bmoc.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ── Domain + TLS (Caddy) ────────────────────────────────────────
# Canonical hostname, WITHOUT scheme or "www". Must already resolve to this
# server's public IP before the first "up", or Let's Encrypt cannot issue.
# The apex 100bmoc.org is a separate WordPress site; the LMS has its subdomain.
APP_DOMAIN=admin.100bmoc.org

# Address Let's Encrypt uses for certificate expiry / problem notices.
ACME_EMAIL=admin@100bmoc.org

# Public URL of the app (password-reset redirect links + Supabase origin).
# Must be https:// and match APP_DOMAIN exactly — no trailing slash.
NEXT_PUBLIC_SITE_URL=https://admin.100bmoc.org

# Loopback-only debug port on the host (container always listens on 3000).
# Not reachable from the internet; Caddy is the public entrypoint.
WEB_PORT=3000

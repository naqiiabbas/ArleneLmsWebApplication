# Reverse proxy + automatic HTTPS for the Arlene LMS app.
#
# Served at the LMS's own subdomain. The apex 100bmoc.org belongs to a separate
# WordPress marketing site on a different server, so only this host is handled
# here. There is no "www." variant of a subdomain, so no redirect block.
#
# Caddy obtains and renews the Let's Encrypt certificate itself; it needs
# ports 80 (ACME HTTP-01 challenge) and 443 reachable, and APP_DOMAIN must
# already resolve to this server. Values come from ./.env via docker compose.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode gzip zstd

	# "web" is the compose service name, on the internal network.
	# Caddy forwards X-Forwarded-* to the upstream by default.
	reverse_proxy web:3000

	header {
		# Deliberately 30 days, not a year. A long HSTS pin on 100bmoc.org is
		# what made moving that domain to WordPress painful: browsers refused
		# plain HTTP there for a year afterwards. 30 days still protects the
		# auth cookies and keeps the iPad kiosk on a secure origin, while
		# capping the damage if this host ever has to move. Raise it only once
		# the subdomain is known to be permanent.
		Strict-Transport-Security "max-age=2592000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ── Reverting to IP-only mode, if the subdomain ever goes away ──────────
# Replace everything above with:
#
#	{
#		auto_https off
#	}
#
#	:80 {
#		encode gzip zstd
#		reverse_proxy web:3000
#	}
#
# Let's Encrypt cannot issue for a bare IP, and leaving auto-HTTPS on makes
# Caddy 308-redirect to https://<ip>/ and serve a mismatched certificate.
